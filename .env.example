# LLM API key (required — pick one)
GEMINI_API_KEY=AIza...
# For an OpenAI-compatible Gemini proxy, uncomment both values:
# GEMINI_BASE_URL=https://api.example.com/v1
# GEMINI_MODEL=provider/gemini-model
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash

# Optional: real HITL interrupts (default: mock approval)
# LANGGRAPH_INTERRUPT=true
# LLM_EVALUATE=true  # judge only ambiguous tool results

# Optional: persistence backend
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
